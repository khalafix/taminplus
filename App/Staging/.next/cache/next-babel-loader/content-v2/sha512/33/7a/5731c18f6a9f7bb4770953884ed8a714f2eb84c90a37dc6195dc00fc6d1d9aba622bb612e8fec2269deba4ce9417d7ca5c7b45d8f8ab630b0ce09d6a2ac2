  }\r\n}\r\n\r\nexport async function getStaticPaths() {\r\n\r\n    var paths = await getPostsSlugs();\r\n    paths = paths.data.items.map(q => ({ params: { slug: `${q.seoUrl}` } }))\r\n    return {\r\n        paths: paths,\r\n        fallback: true,\r\n        \r\n    };\r\n}"]},"metadata":{},"sourceType":"module"}