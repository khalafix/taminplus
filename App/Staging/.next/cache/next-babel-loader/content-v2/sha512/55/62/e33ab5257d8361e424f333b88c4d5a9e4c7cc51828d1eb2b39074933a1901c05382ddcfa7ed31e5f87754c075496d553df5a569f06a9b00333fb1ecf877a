{"ast":null,"code":"import * as types from 'redux/types';\nimport { v4 as uuidv4 } from 'uuid';\nexport var removeItem = function removeItem(id) {\n  var items = JSON.parse(localStorage.getItem(\"shopping-card\"));\n  items = items.filter(function (q) {\n    return q.id != id;\n  });\n\n  if (items.length == 0) {\n    localStorage.removeItem(\"shopping-card\");\n  }\n\n  localStorage.setItem(\"shopping-card\", JSON.stringify(items));\n  return {\n    type: types.SHOPPING_CARD_REMOVE_ITEM,\n    payload: {\n      id: id\n    }\n  };\n};\nexport var addItem = function addItem(item, init) {\n  if (init) {\n    return {\n      type: types.SHOPPING_CARD_ADD_ITEM,\n      payload: item\n    };\n  }\n\n  var model = {\n    id: item.id,\n    title: item.title,\n    price: item.price,\n    courseId: item.courseId\n  };\n  var items = [];\n\n  if (localStorage.getItem(\"shopping-card\") != null) {\n    items = JSON.parse(localStorage.getItem(\"shopping-card\"));\n  }\n\n  items.push(model);\n  ;\n\n  if (!model.courseId) {\n    items = items.filter(function (q) {\n      return q.courseId != model.id;\n    });\n  }\n\n  localStorage.setItem(\"shopping-card\", JSON.stringify(items));\n  return {\n    type: types.SHOPPING_CARD_ADD_ITEM,\n    payload: items\n  };\n};\nexport var clear = function clear() {\n  var items = JSON.parse(localStorage.getItem(\"shopping-card\"));\n\n  if (items.length == 0) {\n    localStorage.removeItem(\"shopping-card\");\n  }\n\n  return {\n    type: types.SHOPPING_CARD_CLEAR\n  };\n};","map":null,"metadata":{},"sourceType":"module"}