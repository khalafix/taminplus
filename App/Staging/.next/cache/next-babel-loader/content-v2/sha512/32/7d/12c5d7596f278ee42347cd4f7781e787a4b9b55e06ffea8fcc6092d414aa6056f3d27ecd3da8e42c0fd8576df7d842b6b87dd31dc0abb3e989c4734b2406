router'\r\nimport Head from \"next/head\";\r\n\r\nconst transformHref = (content) => {\r\n    if (content) {\r\n\r\n        return content.replace(/\\.\\.\\//g, \"\").replace(/\\\"Files/gi, '\"/Files').replace(/\\/Files/gi, \"https://repo.logonomy.ir/Files\").replace(/http:\\/\\/nextapi.logonomy.ir/g, \"\")\r\n    }\r\n}\r\n\r\nconst Courses = (props) => {\r\n    var router = useRouter();\r\n    let [orderInfos, setOrderInfos] = useState();\r\n    let [isFullPurchased, setIsFullPurchased] = useState();\r\n\r\n    if (!props.course) {\r\n        return (<div> </div>)\r\n    }\r\n    const breadCrumbConfig = [\r\n        {\r\n            title: props.course.title,\r\n            link: `/courses/${props.course.id}`\r\n        }\r\n    ];\r\n\r\n    const courseClickVerify = (item) => {\r\n        if ((orderInfos?.courseLessonIds.some(q => q == item.id) || isFullPurchased || item.price == 0 || props.course.price == 0)) {\r\n            router.push(`/courses/${item.courseId}/${item.id}`);\r\n        }\r\n    }\r\n\r\n    useEffect(async () => {\r\n        var userId = getUserid();\r\n        if (userId) {\r\n            var orderHistory = await getUserOrderHistory(userId);\r\n            setIsFullPurchased((orderHistory?.courseIds.some(q => q == props.course.id)) || props.course.price == 0)\r\n            setOrderInfos(orderHistory);\r\n        };\r\n    }, [props.course]);\r\n\r\n    return (\r\n        <>\r\n            <Head>\r\n                <title>{props.course.title}</title>\r\n                <meta name=\"description\" content={`${props.course.abstract}`} />\r\n            </Head>\r\n            <CourseLayout syllabus={true} teacherConfig={props.relatedteacher} breadCrumbConfig={breadCrumbConfig}>\r\n                <div className=\"col-12 batch-buy-course-container\" >\r\n                    <div className=\"batch-buy-course\">\r\n                        <div className=\"course-title\">\r\n                            <h1 className=\"mb-3\"> {props.course.title}</h1>\r\n                            <label className=\"text-white m-0 ml-2\">قیمت کل دوره : </label>\r\n                            <label className=\"off-price m-0 text-white\">\r\n                                {props.course.price.toLocaleString()}\r\n                                <small className=\"mr-2 font-weight-bold\">\r\n                                    ریال\r\n                                </small>\r\n                            </label>\r\n                        </div>\r\n                        <div className=\"d-flex justify-content-center\">\r\n                            {props.course.syllabusPageUrl && <Link href={props.course.syllabusPageUrl}>\r\n                                <a className=\"btn cs-btn-one bg-danger text-white btn-sm m-0 p-2 d-block ml-3\">سیلابس دوره</a>\r\n                            </Link>}\r\n                            {!isFullPurchased && props.course.price > 0 ? <a onClick={() => {\r\n                                if (!props.items.filter(q => !q.courseId).some(q => q.id == props.course.id)) {\r\n                                    props.addItem({ id: props.course.id, title: props.course.title, price: props.course.price, courseId: null });\r\n                                    toast.success('✔️ آیتم به سبد خرید شما اضافه شد.');\r\n                                }\r\n                                else {\r\n                                    toast.info('⚠️ این آیتم در سبد خرید شما موجود می باشد.');\r\n                                }\r\n                            }\r\n                            } className=\"btn cs-btn-one bg-success text-white btn-sm m-0 p-2 d-block\">\r\n                                اضافه به سبد خرید\r\n                                    </a> :\r\n                                null}\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                {\r\n                    props.course.courseLessons.map((item, index) => {\r\n                 